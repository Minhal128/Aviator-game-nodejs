# ===== @ludo/server — ludo-game process (Sprint 2) =====
# The game server binds to localhost only; nginx terminates TLS and proxies
# the WebSocket upgrade (ARQUITECTURA §2.3 / §11.4).

# Port for the Colyseus WebSocket server.
# GAME_PORT=8107

# Bind address. Keep 127.0.0.1 behind nginx; 0.0.0.0 only for LAN testing.
# GAME_HOST=127.0.0.1

# Log verbosity: silent | error | warn | info | debug
# LOG_LEVEL=info

# ===== @ludo/server — ludo-api process (Sprint 3) =====
# REST /api/* + admin + webhooks. Second entrypoint of the SAME package;
# both processes share this file (server/.env wins over repo-root .env,
# process env wins over both).

# Port/bind for the REST API. Dev default 8110; the installer writes 3000
# for production behind nginx.
# API_PORT=8110
# API_HOST=127.0.0.1

# MySQL 8 / MariaDB 10.6+ connection, shared by BOTH processes.
# DATABASE_URL=mysql://ludo:secret@127.0.0.1:3306/ludo_royale

# Separate database for the vitest suite (test/*.db tests TRUNCATE every
# lr_ table between cases — NEVER point this at real data).
# DATABASE_URL_TEST=mysql://ludo:secret@127.0.0.1:3306/ludo_royale_test

# HS256 secret for player/admin JWTs, shared by BOTH processes (§8.2).
# 256-bit minimum; the installer generates it: openssl rand -base64 48
# JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Comma-separated browser origins allowed via CORS. Leave unset when nginx
# serves game + API under one domain (same-origin). Example:
# ALLOWED_ORIGINS=https://ludo.example.com,https://staging.ludo.example.com

# Optional: seeds a placeholder row in lr_admin_users on first `npm run
# db:seed` (reserved for a future admin panel — no route reads this table in
# v1.0). Leave unset and the seeder generates a random password and prints
# it once to the console instead.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-this-to-something-with-10-or-more-characters
