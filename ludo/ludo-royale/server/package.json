{
  "name": "@ludo/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ludo Royale server package — TWO processes, one codebase: ludo-game (game.entry.ts, Colyseus 0.17) and ludo-api (api.entry.ts, Express + Drizzle/MySQL) sharing db/ and services/.",
  "scripts": {
    "dev": "tsx watch src/game.entry.ts",
    "api:dev": "tsx watch src/api.entry.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/game.entry.js",
    "api:start": "node dist/api.entry.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.0",
    "@ludo/shared": "*",
    "bcryptjs": "^3.0.2",
    "colyseus": "^0.17.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "mysql2": "^3.14.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.0",
    "@colyseus/testing": "^0.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
