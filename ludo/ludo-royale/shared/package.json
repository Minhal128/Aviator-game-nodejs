{
  "name": "@ludo/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ludo Royale rules engine: pure, deterministic TypeScript. Shared verbatim by the Phaser client and the Colyseus server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
